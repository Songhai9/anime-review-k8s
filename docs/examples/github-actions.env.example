# GitHub Actions settings for anime-review-k8s (.github/workflows/deploy.yml).
# CHECKLIST ONLY: the workflow does not read this file.

# Settings → Secrets and variables → Actions → Variables
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/k8s-cd      # infra: terraform output -raw k8s_cd_arn
AWS_REGION=eu-north-1
K8S_TRANSFER_BUCKET=replace-me-anime-review-ansible-ssm-eu-north-1

# No secret needed here: AWS access goes through OIDC (id-token: write),
# the values commit uses GITHUB_TOKEN (contents: write).

# Branch protection on main: allow github-actions[bot] to push, or the values commit fails.

# Callers (in the OTHER repositories): secret K8S_WORKFLOW_TOKEN =
# fine-grained PAT with access to this repository only, permission "Actions: Read and write".
#
# Manual dispatch (Actions → Kubernetes CD → Run workflow):
#   image_tag=<short sha>  backend_repository=ghcr.io/<owner>/anime-review-backend
#   frontend_repository=ghcr.io/<owner>/anime-review-frontend  bootstrap_cluster=false
