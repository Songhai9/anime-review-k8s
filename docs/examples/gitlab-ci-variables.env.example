# GitLab CI/CD settings for the anime-review-k8s project.
# CHECKLIST ONLY: the pipeline does not read this file. Never commit real values.

# Settings → CI/CD → Variables (protected, main protected)
# Output of: terraform -chdir=terraform output -raw k8s_cd_arn   (anime-review-infra)
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/k8s-cd

# Defined in .gitlab-ci.yml — edit there if your names differ:
#   AWS_REGION=eu-north-1
#   K8S_TRANSFER_BUCKET=replace-me-anime-review-ansible-ssm-eu-north-1
#   BOOTSTRAP_CLUSTER=false

# Forwarded by other pipelines — do NOT define them here:
#   IMAGE_TAG            (anime-review-app → trigger_k8s)
#   BACKEND_IMAGE / FRONTEND_IMAGE (forwarded but unused)
#   BOOTSTRAP_CLUSTER=true (anime-review-infra → bootstrap_k8s)

# Settings → CI/CD → Job token permissions
#   - allow anime-review-app and anime-review-infra to trigger pipelines here
#   - enable "Allow Git push requests to the repository" (update_manifests pushes values.yaml)

# Repository → Protected branches → main: the job token must be allowed to push.
