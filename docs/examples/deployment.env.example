# Copy outside Git; source in the shell on the cluster administration machine.
# Repository scripts do NOT load this file automatically.
export AWS_REGION=eu-north-1
export AWS_DEFAULT_REGION=eu-north-1
export KUBECONFIG=/etc/kubernetes/admin.conf
export BACKEND_IMAGE=registry.gitlab.com/YOUR_GROUP/YOUR_APP/backend:REPLACE_TAG
export FRONTEND_IMAGE=registry.gitlab.com/YOUR_GROUP/YOUR_APP/frontend:REPLACE_TAG
# SQL password: Parameter Store, not this file.
# Registry credentials: entered interactively when creating the Secret.
