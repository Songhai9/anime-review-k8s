# Operator shell variables for manual work on the control plane.
# Copy outside Git (e.g. /root/anime-review.env), edit, then: . /root/anime-review.env
# The scripts in this repository do NOT read this file; it only saves typing.
export AWS_REGION=eu-north-1
export AWS_DEFAULT_REGION=eu-north-1
export KUBECONFIG=/etc/kubernetes/admin.conf
export NAMESPACE=anime-review
export RELEASE=anime-review

# Tag published by anime-review-app CI (short commit SHA). Used with:
#   helm upgrade --install $RELEASE ./charts/anime-review -n $NAMESPACE \
#     --set backend.image.tag=$IMAGE_TAG --set frontend.image.tag=$IMAGE_TAG ...
export IMAGE_TAG=REPLACE_WITH_SHORT_SHA

# Not here on purpose:
#  - PostgreSQL password → SSM Parameter Store /anime-review/postgres/password
#  - registry deploy token → typed interactively when creating the gitlab-registry Secret
