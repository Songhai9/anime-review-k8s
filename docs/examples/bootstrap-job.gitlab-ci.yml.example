# PROPOSAL (GitLab CI only) — append this job to .gitlab-ci.yml. The GitHub workflow deploy.yml already handles bootstrap_cluster.
# It restores the bootstrap_cluster job that existed until commit 726bb49 (see ffed923),
# so that anime-review-infra's bootstrap_k8s trigger (BOOTSTRAP_CLUSTER=true) has a job to run.
# Also replace `--atomic` with `--rollback-on-failure` in bootstrap-cluster.sh if your Helm 4 rejects it.
#
# Required permissions already exist in anime-review-infra/terraform/main.tf:
#   k8s-cd role        → s3:PutObject/DeleteObject on k8s-bootstrap/*, ssm:SendCommand, ec2:DescribeInstances
#   control-plane role → s3:GetObject on k8s-bootstrap/*, ssm:GetParameter on /anime-review/postgres/password

bootstrap_cluster:
  stage: deploy
  resource_group: anime-review-cluster

  rules:
    - if: '$CI_PIPELINE_SOURCE == "pipeline" && $BOOTSTRAP_CLUSTER == "true"'

  image:
    name: registry.gitlab.com/gitlab-org/cloud-deploy/aws-base:latest
    entrypoint: [""]

  id_tokens:
    GITLAB_OIDC_TOKEN:
      aud: sts.amazonaws.com

  before_script:
    - apt-get update
    - apt-get install -y jq

  script:
    - |
      set -euo pipefail

      aws_sts_output=$(aws sts assume-role-with-web-identity \
        --role-arn "$AWS_ROLE_ARN" \
        --role-session-name "GitLabRunner-${CI_PROJECT_ID}-${CI_PIPELINE_ID}" \
        --web-identity-token "$GITLAB_OIDC_TOKEN" \
        --duration-seconds 3600 \
        --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
        --output text)
      export $(printf "AWS_ACCESS_KEY_ID=%s AWS_SECRET_ACCESS_KEY=%s AWS_SESSION_TOKEN=%s" $aws_sts_output)

      CONTROL_PLANE_INSTANCE_ID=$(aws ec2 describe-instances \
        --filters "Name=tag:Name,Values=anime-review-control-plane" \
                  "Name=instance-state-name,Values=running" \
        --query 'Reservations[0].Instances[0].InstanceId' --output text)
      test -n "$CONTROL_PLANE_INSTANCE_ID" && test "$CONTROL_PLANE_INSTANCE_ID" != "None"
      echo "Control plane: $CONTROL_PLANE_INSTANCE_ID"

      ARTIFACT="/tmp/anime-review-k8s-${CI_COMMIT_SHA}.tar.gz"
      S3_KEY="k8s-bootstrap/${CI_PIPELINE_ID}/${CI_COMMIT_SHA}.tar.gz"
      tar --exclude=.git -czf "$ARTIFACT" .
      aws s3 cp "$ARTIFACT" "s3://${K8S_TRANSFER_BUCKET}/${S3_KEY}" --region "$AWS_REGION"
      trap 'aws s3 rm "s3://${K8S_TRANSFER_BUCKET}/${S3_KEY}" --region "$AWS_REGION" || true' EXIT

      PARAMETERS=$(jq -n --arg bucket "$K8S_TRANSFER_BUCKET" --arg key "$S3_KEY" --arg region "$AWS_REGION" '{
        commands: [
          "set -e",
          "rm -rf /opt/anime-review-k8s /tmp/anime-review-k8s.tar.gz",
          "mkdir -p /opt/anime-review-k8s",
          ("/usr/local/bin/aws s3 cp s3://" + $bucket + "/" + $key + " /tmp/anime-review-k8s.tar.gz --region " + $region),
          "tar -xzf /tmp/anime-review-k8s.tar.gz -C /opt/anime-review-k8s",
          "chmod +x /opt/anime-review-k8s/bootstrap-cluster.sh /opt/anime-review-k8s/install_addons.sh",
          ("cd /opt/anime-review-k8s && AWS_REGION=" + $region + " ./bootstrap-cluster.sh"),
          "rm -f /tmp/anime-review-k8s.tar.gz"
        ],
        executionTimeout: ["1800"]
      }')

      COMMAND_ID=$(aws ssm send-command \
        --instance-ids "$CONTROL_PLANE_INSTANCE_ID" \
        --document-name "AWS-RunShellScript" \
        --parameters "$PARAMETERS" \
        --query 'Command.CommandId' --output text)
      echo "SSM command: $COMMAND_ID"

      for attempt in $(seq 1 120); do
        STATUS=$(aws ssm get-command-invocation --command-id "$COMMAND_ID" \
          --instance-id "$CONTROL_PLANE_INSTANCE_ID" --query 'Status' --output text 2>/dev/null || echo Pending)
        echo "SSM status: $STATUS"
        case "$STATUS" in Success|Failed|Cancelled|TimedOut|Cancelling) break ;; esac
        sleep 10
      done

      aws ssm get-command-invocation --command-id "$COMMAND_ID" \
        --instance-id "$CONTROL_PLANE_INSTANCE_ID" \
        --query '{Status:Status,ExitCode:ResponseCode,Stdout:StandardOutputContent,Stderr:StandardErrorContent}'
      test "$STATUS" = "Success"
