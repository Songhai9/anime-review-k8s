#!/usr/bin/env bash
# Local equivalent of .github/workflows/deploy.yml with bootstrap_cluster=true:
# package this repository, upload it to the transfer bucket, run bootstrap-cluster.sh
# on the control plane with SSM Run Command, then clean up. No SSH, no bastion.
#
# Run from the root of anime-review-k8s, after the infra Ansible step:
#   . ~/.config/anime-review/operator.env      # AWS profile + ANSIBLE_SSM_BUCKET
#   bash docs/examples/bootstrap-via-ssm.sh.example
#
# Optional: INFRA_DIR (default ../anime-review-infra), CONTROL_PLANE_ID (skip the Terraform lookup).
# Needs: aws, jq, terraform, git. Works with macOS (bsdtar, BSD base64) and Linux.

set -euo pipefail

: "${ANSIBLE_SSM_BUCKET:?export ANSIBLE_SSM_BUCKET (transfer bucket, not the state bucket)}"
AWS_REGION="${AWS_REGION:-eu-north-1}"
INFRA_DIR="${INFRA_DIR:-../anime-review-infra}"

[[ -f bootstrap-cluster.sh ]] || { echo "Run this from the anime-review-k8s root"; exit 1; }

CONTROL_PLANE_ID="${CONTROL_PLANE_ID:-$(terraform -chdir="$INFRA_DIR/terraform" output -raw control_plane_instance_id)}"
DEPLOY_SHA="$(git rev-parse HEAD)"
git diff --quiet HEAD || echo "warning: uncommitted changes will be included in the archive"

ARCHIVE="${TMPDIR:-/tmp}/anime-review-k8s-${DEPLOY_SHA}.tar.gz"
S3_KEY="k8s-bootstrap/local/${DEPLOY_SHA}.tar.gz"   # control-plane role may read k8s-bootstrap/*

echo "==> Control plane: $CONTROL_PLANE_ID · commit: $DEPLOY_SHA"

cleanup() {
  aws s3 rm "s3://${ANSIBLE_SSM_BUCKET}/${S3_KEY}" --region "$AWS_REGION" >/dev/null 2>&1 || true
  rm -f "$ARCHIVE"
}
trap cleanup EXIT

echo "==> Packaging repository"
# COPYFILE_DISABLE / --no-xattrs: no macOS ._ files or xattr headers in the archive
COPYFILE_DISABLE=1 tar --no-xattrs --exclude=.git -czf "$ARCHIVE" .

echo "==> Uploading to s3://${ANSIBLE_SSM_BUCKET}/${S3_KEY}"
aws s3 cp "$ARCHIVE" "s3://${ANSIBLE_SSM_BUCKET}/${S3_KEY}" --region "$AWS_REGION"

REMOTE_SCRIPT=$(cat <<EOF
set -euo pipefail
export KUBECONFIG=/etc/kubernetes/admin.conf
export PATH=/usr/local/bin:/usr/bin:/bin:\$PATH
DEPLOY_DIR="/tmp/anime-review-bootstrap-${DEPLOY_SHA}"
ARCHIVE="/tmp/anime-review-k8s-${DEPLOY_SHA}.tar.gz"
rm -rf "\$DEPLOY_DIR" && mkdir -p "\$DEPLOY_DIR"
aws s3 cp "s3://${ANSIBLE_SSM_BUCKET}/${S3_KEY}" "\$ARCHIVE" --region "${AWS_REGION}"
tar -xzf "\$ARCHIVE" -C "\$DEPLOY_DIR"
chmod +x "\$DEPLOY_DIR/bootstrap-cluster.sh" "\$DEPLOY_DIR/install_addons.sh"
cd "\$DEPLOY_DIR"
./bootstrap-cluster.sh
cd / && rm -rf "\$DEPLOY_DIR" "\$ARCHIVE"
EOF
)

# Same transport as the CI: the script travels base64-encoded inside one command.
REMOTE_B64="$(printf '%s' "$REMOTE_SCRIPT" | base64 | tr -d '\n')"
PARAMETERS="$(jq -n --arg c "echo '$REMOTE_B64' | base64 -d | bash" '{commands: [$c]}')"

echo "==> Sending SSM Run Command"
COMMAND_ID="$(aws ssm send-command \
  --instance-ids "$CONTROL_PLANE_ID" \
  --document-name AWS-RunShellScript \
  --comment "anime-review-k8s local bootstrap ${DEPLOY_SHA:0:8}" \
  --parameters "$PARAMETERS" \
  --region "$AWS_REGION" \
  --query 'Command.CommandId' --output text)"
echo "SSM command: $COMMAND_ID"

show() {
  aws ssm get-command-invocation --command-id "$COMMAND_ID" --instance-id "$CONTROL_PLANE_ID" \
    --region "$AWS_REGION" \
    --query '{Status:Status,ExitCode:ResponseCode,Stdout:StandardOutputContent,Stderr:StandardErrorContent}'
}

for attempt in $(seq 1 180); do   # 15 min: add-ons + Helm --wait
  STATUS="$(aws ssm get-command-invocation --command-id "$COMMAND_ID" --instance-id "$CONTROL_PLANE_ID" \
    --region "$AWS_REGION" --query Status --output text 2>/dev/null || echo Pending)"
  echo "[$attempt] $STATUS"
  case "$STATUS" in
    Success) show; echo "==> Bootstrap completed"; exit 0 ;;
    Failed|Cancelled|TimedOut|Cancelling) show; exit 1 ;;
  esac
  sleep 5
done

echo "Timed out waiting for the SSM command (it may still be running on the node)"
exit 1
